DB_RUNTIME_PASSWORD=change_me_runtime_local_only
POSTGRES_PASSWORD=change_me_local_only
APP_ENV=development
APP_NAME=LedgerGate
DATABASE_URL=postgresql+psycopg://ledgergate_runtime:change_me_runtime_local_only@db:5432/ledgergate
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_UNIQUE_FERNET_KEY
# Use a separate versioned S3 bucket created with Object Lock enabled.
AUDIT_WORM_BUCKET=
AUDIT_WORM_RETENTION_DAYS=2555
AUDIT_EXPORT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUDIT_EXPORT_SIGNING_KEY_ID=ledgergate-audit-signing-key-v1
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_API_KEY=EMPTY
LEDGERGATE_API_URL=http://localhost:8000
LEDGERGATE_API_TOKEN=
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
