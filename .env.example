DB_RUNTIME_PASSWORD=change_me_runtime_local_only
POSTGRES_PASSWORD=change_me_local_only
APP_ENV=development
APP_NAME=LedgerGate
DATABASE_URL=postgresql+psycopg://ledgergate_runtime:change_me_runtime_local_only@db:5432/ledgergate
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=REPLACE_WITH_A_UNIQUE_FERNET_KEY
# Use a separate versioned S3 bucket created with Object Lock enabled.
AUDIT_WORM_BUCKET=
AUDIT_WORM_RETENTION_DAYS=2555
AUDIT_EXPORT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUDIT_EXPORT_SIGNING_KEY_ID=ledgergate-audit-signing-key-v1
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_API_KEY=EMPTY
# Optional application-side inference admission, timing and telemetry controls.
# Leave INFERENCE_PROVIDER unset to preserve LLM_PROVIDER compatibility.
INFERENCE_PROVIDER=
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_CONNECT_TIMEOUT_SECONDS=5
INFERENCE_MAX_CONCURRENT=8
INFERENCE_MAX_QUEUE_SIZE=32
INFERENCE_QUEUE_WAIT_SECONDS=5
INFERENCE_MAX_RETRIES=1
INFERENCE_RETRY_BACKOFF_SECONDS=0.25
INFERENCE_MAX_OUTPUT_TOKENS=1024
INFERENCE_TEMPERATURE=0.1
# Optional Ollama request/keep-alive settings.
OLLAMA_NUM_CTX=
OLLAMA_NUM_BATCH=
OLLAMA_NUM_GPU=
OLLAMA_KEEP_ALIVE=
# Optional vLLM/DCGM Prometheus endpoint and local tokenizer cache path.
INFERENCE_PROMETHEUS_URL=
BENCHMARK_TOKENIZER=
INFERENCE_MODEL_REVISION=
LEDGERGATE_API_URL=http://localhost:8000
LEDGERGATE_API_TOKEN=
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20

# Account recovery delivery. Production requires authenticated SMTP with STARTTLS.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=LedgerGate <no-reply@example.com>
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_OUTBOX_ENCRYPTION_KEY=
# Optional comma-separated previous Fernet keys during rotation; remove after queue drain.
EMAIL_OUTBOX_DECRYPTION_KEYS=
PUBLIC_APP_URL=http://localhost:3000
