APP_ENV=development
APP_NAME=LedgerGate
DATABASE_URL=postgresql+psycopg://ledgergate_runtime:runtime_local_only_change_me@db:5432/ledgergate
POSTGRES_PASSWORD=change_me_local_only
LEDGERGATE_RUNTIME_PASSWORD=runtime_local_only_change_me
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=15
MAX_UPLOAD_PDF_PAGES=100
DUAL_APPROVAL_THRESHOLD_INR=100000
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_API_KEY=EMPTY
