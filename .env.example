APP_ENV=development
APP_NAME=LedgerGate
DATABASE_URL=postgresql+psycopg://ledgergate_runtime:runtime_local_only_change_me@db:5432/ledgergate
POSTGRES_PASSWORD=change_me_local_only
LEDGERGATE_RUNTIME_PASSWORD=runtime_local_only_change_me
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/app/uploads
# Production must use a private S3-compatible bucket.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
# Required in production. LedgerGate streams uploads to clamd using its INSTREAM protocol.
MALWARE_SCAN_HOST=
MALWARE_SCAN_PORT=3310
MALWARE_SCAN_TIMEOUT_SECONDS=30
# Required in production for password recovery; use an SMTP submission service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL_BASE=
MAX_UPLOAD_MB=15
MAX_UPLOAD_PDF_PAGES=100
DUAL_APPROVAL_THRESHOLD_INR=100000
LLM_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_API_KEY=EMPTY
LEDGERGATE_API_URL=http://localhost:8000
LEDGERGATE_API_TOKEN=
